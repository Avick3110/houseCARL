<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HousecarlGenerator</RootNamespace>
    <AssemblyName>housecarl-generator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reflection target. Pinned to match housecarl-mcp and housecarl-core; the three move together on a bump. -->
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- The C# parser, for description-vocab-guard's READER A (#386). The guard's net is "every string literal in
         the shipped source trees", and what counts as a literal is the compiler's decision, not a matter of
         opinion — two hand-written designs of that guard were measured green over prose their own lexers could not
         see. Roslyn is that decision, and HandLiteralLexer is the independent second spelling its output is held
         against. BUILD-TIME ONLY: the generator regenerates corpus.json and runs the guards; build-plugin.ps1
         publishes housecarl-mcp and housecarl-setup and never this project, so nothing here reaches a release and
         THIRD-PARTY-NOTICES.txt is untouched.
         Pinned, and the pin is load-bearing: the parse runs at LanguageVersion.Preview, so a language feature
         newer than this package is a PARSE ERROR that INV6-PARSE names, never a construct read into fewer
         literals. Bump it deliberately when the codebase adopts a newer C# — the guard will say so first. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\housecarl-core\housecarl-core.csproj" />
    <!-- The CI regression guards drive the SERVICE-layer scan logic (LoadOrderService.CrossQuery, via the
         ForGuard seam) — the first CI coverage of the mcp layer (PR #23 follow-up). -->
    <ProjectReference Include="..\housecarl-mcp\housecarl-mcp.csproj" />
    <!-- The setup update-lock guard (HCBR item 9.1 / PR-M) drives the real installer's now-public
         Program.TryInstall seam — the only way to regression-test the locked-server pre-flight in CI. -->
    <ProjectReference Include="..\housecarl-setup\housecarl-setup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- §8.4 tidy: the core's namespace is now HousecarlCore (was HousecarlGenerator). One global
         using keeps every harness file referencing the proven engines unqualified, as before the
         rename — the files themselves stay in `namespace HousecarlGenerator` (this IS the generator). -->
    <Using Include="HousecarlCore" />
  </ItemGroup>

</Project>
