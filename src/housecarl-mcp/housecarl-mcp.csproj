<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    houseCARL MCP server (rebuild step 8 / MCP-server step §8.4). The PRODUCT: a localhost HTTP MCP
    server (fork §6-A) that runs STANDALONE — it reads the TRUE active order statically from the MO2
    instance's profile files (§8.5; no USVFS, no live MO2 state, MO2 need not be running). It binds
    127.0.0.1 and Claude Code connects as a custom connector. Tools ride the PROVEN cores in
    housecarl-core — reads on ReadEngine + LoadOrderResolver, writes on WriteEngine.ApplyVerb — so the
    byte-/round-trip proofs transfer by construction. Web SDK supplies WebApplication;
    ModelContextProtocol.AspNetCore supplies WithHttpTransport()/MapMcp().
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HousecarlMcp</RootNamespace>
    <AssemblyName>housecarl-mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.53.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\housecarl-core\housecarl-core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- §8.4: the proven engines live in HousecarlCore; one global using keeps the tools + service referencing
         them unqualified. The server's own code stays in `namespace HousecarlMcp`. -->
    <Using Include="HousecarlCore" />
  </ItemGroup>

</Project>
