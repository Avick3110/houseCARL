<Project Sdk="Microsoft.NET.Sdk">

  <!--
    houseCARL MCP server, over stdio. It runs STANDALONE: it reads the TRUE active order statically from the
    MO2 instance's profile files (no USVFS, no live MO2 state, MO2 need not be running). Tools ride the PROVEN
    cores in housecarl-core (reads on ReadEngine + LoadOrderResolver, writes on WriteEngine.ApplyVerb), so the
    byte-/round-trip proofs transfer by construction. The plain SDK, so the user needs only the .NET runtime;
    Microsoft.Extensions.Hosting supplies the generic host and Microsoft.Extensions.Http the Nexus HttpClient.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HousecarlMcp</RootNamespace>
    <AssemblyName>housecarl-mcp</AssemblyName>
    <!-- ServerInfo.Version truth: build-plugin.ps1 overrides with -p:Version from plugin.json (the single
         version home), so a release exe reports the real release; an unstamped dev build says 0.0.0-dev. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Server GC, chosen deliberately. Measured against workstation GC, gen0 budgets,
         heap-count caps and ConserveMemory (issue #717): elapsed was flat across all nine, and Server GC held the
         least after a merge (559 MB against 1.1 to 5.3 GB for the six alternatives with an idle figure; the
         gcServer=0 + ConserveMemory=5 row, best on the merge and tree peaks, has none). Peak working set is live
         objects, bounded by the read paths themselves, not by the collector. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\housecarl-core\housecarl-core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Decompiler baseline hierarchy: vanilla ScriptName-extends edges, generated by construction from the
         CK vanilla sources (generator mode `class-parents`). COMMITTED because vanilla sources install with
         the CK, not the game — a fresh checkout / CI cannot regenerate it. Rides `dotnet publish` beside the
         exe (the corpus-beside-exe pattern); regenerate manually on a game update. -->
    <None Update="vanilla-class-parents.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Local-dev config beside the exe; build-plugin.ps1 strips it from the shipped server. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- §8.4: the proven engines live in HousecarlCore; one global using keeps the tools + service referencing
         them unqualified. The server's own code stays in `namespace HousecarlMcp`. -->
    <Using Include="HousecarlCore" />
    <!-- The hosting namespaces the Web SDK imported implicitly. -->
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
