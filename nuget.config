<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- packages/local holds the one package houseCARL builds itself: Nifly 1.1.0-housecarl.1, NiflySharp with the
       mesh reader's counts bounded (issue #926). nuget.org serves everything else. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="housecarl-local" value="packages/local" />
  </packageSources>
</configuration>
