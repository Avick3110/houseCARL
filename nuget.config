<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- packages/local holds the one package houseCARL builds itself, Nifly (the NiflySharp fork, issue #926); nuget.org serves the rest. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="housecarl-local" value="packages/local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="housecarl-local">
      <package pattern="Nifly" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
